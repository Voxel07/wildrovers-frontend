VITE_API_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=https://auth.example.com/application/o/example/
VITE_OIDC_CLIENT_ID=your-oidc-client-id-here
VITE_OIDC_REDIRECT_URI=http://localhost:5173/Login

VITE_IMMICH_PROXY_URL="https://photos.example.com/share/your-share-key"
VITE_IMMICH_DROP_URL="https://photos.example.com/invite/your-invite-code"
VITE_IMMICH_KIOSK_URL="https://kiosk.example.com"

# OpenObserve Dev Configuration
# Set to false during local dev to disable RUM/Logs collection
VITE_OPENOBSERVE_ENABLED=true
VITE_OPENOBSERVE_SITE=https://obs.example.com
VITE_OPENOBSERVE_RUM_KEY=your-openobserve-rum-key
VITE_OPENOBSERVE_APP_ID=wildrovers-frontend
VITE_OPENOBSERVE_ORG=default
VITE_OPENOBSERVE_INSECURE_HTTP=false
